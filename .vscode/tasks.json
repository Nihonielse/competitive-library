{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build current C++",
			"type": "shell",
			"command": "./build/build-cpp",
			"args": ["${file}"],
			"options": {
				"cwd": "${workspaceFolder}",
				"shell": {
					"executable": "/bin/zsh",
					"args": ["-l", "-c"]
				}
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			}
		}
	]
}
